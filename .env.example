# Arena — environment variables
# Copy to .env.local for local dev, or `vercel env pull .env.local` to pull
# real values already configured in the Vercel dashboard. Never commit a real
# value. Add a var here in the same change that starts requiring it —
# see docs/DEVELOPMENT.md.

# --- Neon Postgres (Marketplace) ---
# Provisioned via Vercel dashboard → Storage → Neon Postgres → Connect to
# Project. Do not hand-create this — the Marketplace integration wires it in.
DATABASE_URL=

# --- Vercel Blob ---
# Provisioned via Vercel dashboard → Storage → Blob → Create Store.
BLOB_READ_WRITE_TOKEN=

# --- Edge Config ---
# Provisioned via Vercel dashboard → Storage → Edge Config → Create Store.
EDGE_CONFIG=

# --- AI Gateway ---
# No separate API key required for Vercel's own AI Gateway when running on
# Vercel infra (auth is via the platform's own OIDC token). If running
# `vercel dev` and it's not picking this up automatically, check current
# AI Gateway docs — this mechanism has moved before.
AI_GATEWAY_API_KEY=

# --- Connect (beta) ---
# Discord and GitHub connectors are registered in the Vercel dashboard under
# Connect. This app requests short-lived tokens at call time via
# @vercel/connect — it does NOT hold a standing Discord bot token or GitHub
# PAT here. If you find yourself about to add one, stop and re-read
# docs/SECURITY.md.
CONNECT_PROJECT_ID=

# --- Internal/operator auth ---
# Shared secret for /api/internal/* routes (docs/API.md). Generate a real
# random value, never reuse across environments.
INTERNAL_TOKEN=

# --- Cron verification ---
# Whatever mechanism current Vercel Cron docs specify for verifying a request
# actually came from Vercel's Cron invoker — confirm the exact header/secret
# during M0, don't assume this is a manually-set value.
CRON_SECRET=
